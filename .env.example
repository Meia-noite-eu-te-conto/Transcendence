# Copie para .env.local e preencha. NÃO commite valores reais.
# O .env versionado neste repositório contém credenciais e deve ser tratado
# como comprometido — rotacione antes de qualquer deploy (ver ADR-0007).

# --- legado: User-Session ---
USER_SESSION_POSTGRES_USER=
USER_SESSION_POSTGRES_PASSWORD=
USER_SESSION_POSTGRES_DB=

# --- legado: Game-Core ---
CORE_GAME_POSTGRES_USER=
CORE_GAME_POSTGRES_PASSWORD=
CORE_GAME_POSTGRES_DB=

# --- Redis (legado: channel layer + filas; alvo: lease, presença, rate limit) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Django (legado) — gerar novos, os atuais estão fixos no settings.py ---
USER_SESSION_SECRET_KEY=
GAME_CORE_SECRET_KEY=

# --- alvo: serviços Go ---
# LOBBY_DATABASE_URL=postgres://user:pass@pg-lobby:5432/lobby?sslmode=disable
# STATS_DATABASE_URL=postgres://user:pass@pg-stats:5432/stats?sslmode=disable
# NATS_URL=nats://nats:4222
# JWT_SECRET=
# JWT_ACCESS_TTL=15m
# LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
